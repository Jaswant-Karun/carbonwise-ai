DATABASE_URL=postgresql://username:password@localhost:5432/carbonwise
JWT_SECRET=replace-with-a-long-random-secret
# Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey (starts with AIzaSy...)
# When unconfigured or invalid, CarbonWise AI automatically activates high-quality deterministic fallback engines.
GEMINI_API_KEY=AIzaSy_your_valid_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_OUTPUT_TOKENS=380
GEMINI_CACHE_TTL_MS=86400000
GEMINI_RATE_LIMIT_PER_MINUTE=10
PG_SSL=false
PORT=5000
ENVIRONMENT_SYNC_INTERVAL_MS=1800000
