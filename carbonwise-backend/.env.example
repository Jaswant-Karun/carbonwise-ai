DATABASE_URL=postgresql://username:password@localhost:5432/carbonwise
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional Gemini controls; keep the default model unless verified against the installed SDK/API account.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_OUTPUT_TOKENS=320
GEMINI_CACHE_TTL_MS=86400000
GEMINI_RATE_LIMIT_PER_MINUTE=10
PG_SSL=false
PORT=5000
